---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';

const items = (await getCollection('attractions', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const crumbs = [
  { name: '首頁', href: '/' },
  { name: '旗津景點', href: '/attractions/' },
];
---
<BaseLayout
  title="旗津景點地圖與必去景點"
  description="旗津主要景點整理：旗津天后宮、旗后燈塔、旗后砲台、星空隧道、旗津海水浴場、彩虹教堂與風車公園，含距離輪渡站、是否爬坡與建議停留時間。"
  breadcrumbs={crumbs}
>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <header class="mb-8 max-w-2xl">
      <h1 class="text-3xl font-bold text-harbor-900">旗津景點</h1>
      <p class="mt-3 text-ink-700 leading-relaxed">
        旗津的景點大多從旗津輪渡站步行或短程騎行可達。以下依「與輪渡站的距離」與是否需要爬坡整理，
        方便你安排順路的行程。想直接規劃路線，可到<a href="/itinerary/" class="text-sea-700 underline underline-offset-2">行程規劃</a>或<a href="/map/" class="text-sea-700 underline underline-offset-2">實用地圖</a>。
      </p>
    </header>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <Card
          href={`/attractions/${item.id}/`}
          title={item.data.name}
          subtitle={item.data.summary}
          image={item.data.image}
          imageAlt={item.data.imageAlt}
          meta={[item.data.distanceFromFerry && `距輪渡站 ${item.data.distanceFromFerry}`, item.data.slope].filter(Boolean).join('・')}
        />
      ))}
    </div>
  </div>
</BaseLayout>
