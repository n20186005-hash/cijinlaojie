---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pic from '../../components/Pic.astro';
import PlaceFacts from '../../components/PlaceFacts.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import SourceList from '../../components/SourceList.astro';
import { abs } from '../../lib/seo';

export async function getStaticPaths() {
  const items = await getCollection('attractions', ({ data }) => !data.draft);
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const d = item.data;
const { Content } = await render(item);

const crumbs = [
  { name: '首頁', href: '/' },
  { name: '旗津景點', href: '/attractions/' },
  { name: d.name, href: `/attractions/${item.id}/` },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristAttraction',
    name: d.name,
    alternateName: d.englishName,
    description: d.summary,
    image: abs(d.image),
    ...(d.address && { address: { '@type': 'PostalAddress', streetAddress: d.address, addressCountry: 'TW' } }),
    ...(d.latitude && d.longitude && { geo: { '@type': 'GeoCoordinates', latitude: d.latitude, longitude: d.longitude } }),
    ...(d.openingHours && { openingHours: d.openingHours }),
    isAccessibleForFree: d.admission === '免費',
  },
];
---
<BaseLayout
  title={d.name}
  description={d.quickAnswer || d.summary}
  image={d.image}
  breadcrumbs={crumbs}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-3xl px-4 py-6">
    <header class="mb-6">
      <h1 class="text-3xl font-bold text-harbor-900">{d.name}</h1>
      {d.englishName && <p class="mt-1 text-sm font-semibold tracking-wide text-sea-500">{d.englishName}</p>}
      <p class="mt-3 text-lg text-ink-700 leading-relaxed">{d.summary}</p>
    </header>

    <Pic
      src={d.image}
      alt={d.imageAlt}
      sizes="(max-width: 768px) 100vw, 768px"
      class="w-full rounded-xl object-cover aspect-[3/2] shadow-sm"
      eager
      aspect="3/2"
    />

    {d.quickAnswer && (
      <div class="mt-6">
        <QuickAnswer question={`${d.name}值得去嗎？`}>{d.quickAnswer}</QuickAnswer>
      </div>
    )}

    <div class="mt-6">
      <PlaceFacts
        openingHours={d.openingHours}
        admission={d.admission}
        address={d.address}
        suggestedDuration={d.suggestedDuration}
        distanceFromFerry={d.distanceFromFerry}
        walkTime={d.walkTime}
        slope={d.slope}
        accessibility={d.accessibility}
        bestTime={d.bestTime}
      />
    </div>

    <div class="prose-cijin mt-8 max-w-none">
      <Content />
    </div>

    <SourceList sources={d.sources} lastChecked={d.lastChecked} />

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/attractions/" class="text-sm font-semibold text-sea-700 hover:text-sea-500">← 所有旗津景點</a>
      <a href="/map/" class="text-sm font-semibold text-sea-700 hover:text-sea-500">在地圖上查看 →</a>
    </div>
  </article>
</BaseLayout>
