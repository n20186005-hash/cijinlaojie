---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pic from '../../components/Pic.astro';
import RouteTimeline from '../../components/RouteTimeline.astro';
import SourceList from '../../components/SourceList.astro';
import { abs } from '../../lib/seo';

export async function getStaticPaths() {
  const items = await getCollection('itinerary', ({ data }) => !data.draft);
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const d = item.data;
const { Content } = await render(item);

const crumbs = [
  { name: '首頁', href: '/' },
  { name: '行程規劃', href: '/itinerary/' },
  { name: d.title, href: `/itinerary/${item.id}/` },
];

const facts: [string, string | undefined][] = [
  ['建議時間', d.duration],
  ['總步行距離', d.totalWalk],
  ['預算', d.budget],
  ['適合對象', d.suitableFor],
  ['是否建議租車', d.bikeSuggested === undefined ? undefined : d.bikeSuggested ? '建議' : '不需要'],
];

const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  image: abs(d.image),
  description: d.summary,
  datePublished: d.lastChecked,
  dateModified: d.lastChecked,
  author: { '@type': 'Organization', name: '旗津老街' },
  publisher: { '@type': 'Organization', name: '旗津老街' },
}];
---
<BaseLayout title={d.title} description={d.summary} image={d.image} breadcrumbs={crumbs} jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl px-4 py-6">
    <header class="mb-6">
      <p class="text-sm font-semibold text-sunset-600">行程規劃</p>
      <h1 class="mt-1 text-3xl font-bold text-harbor-900">{d.title}</h1>
      <p class="mt-3 text-lg text-ink-700 leading-relaxed">{d.summary}</p>
    </header>

    <Pic src={d.image} alt={d.imageAlt} class="w-full rounded-xl object-cover aspect-[3/2] shadow-sm" eager aspect="3/2" />

    <dl class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3">
      {facts.filter(([, v]) => v).map(([k, v]) => (
        <div class="rounded-lg border border-sand-200 bg-white px-3 py-2">
          <dt class="text-xs text-ink-700">{k}</dt>
          <dd class="mt-0.5 text-sm font-semibold text-harbor-900">{v}</dd>
        </div>
      ))}
    </dl>

    {d.steps && d.steps.length > 0 && (
      <section class="mt-8">
        <h2 class="text-xl font-bold text-harbor-900 mb-4">建議時間表</h2>
        <div class="rounded-xl border border-sand-200 bg-white p-5">
          <RouteTimeline steps={d.steps} />
        </div>
      </section>
    )}

    <div class="prose-cijin mt-8 max-w-none">
      <Content />
    </div>

    <SourceList sources={d.sources} lastChecked={d.lastChecked} />

    <div class="mt-8">
      <a href="/itinerary/" class="text-sm font-semibold text-sea-700 hover:text-sea-500">← 所有行程</a>
    </div>
  </article>
</BaseLayout>
