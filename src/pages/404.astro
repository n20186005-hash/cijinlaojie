---
import BaseLayout from '../layouts/BaseLayout.astro';
import { NAV } from '../config';
---
<BaseLayout title="找不到頁面" description="您要找的頁面不存在，回到旗津老街首頁重新開始。">
  <div class="mx-auto max-w-2xl px-4 py-20 text-center">
    <p class="text-6xl font-bold text-sea-500">404</p>
    <h1 class="mt-4 text-2xl font-bold text-harbor-900">找不到這個頁面</h1>
    <p class="mt-3 text-ink-700">您要找的頁面可能已移動或不存在。試試從下方的主要入口重新開始。</p>
    <div class="mt-8 flex flex-wrap justify-center gap-2.5">
      <a href="/" class="rounded-full bg-harbor-900 px-4 py-2 text-sm font-semibold text-sand-50 hover:bg-harbor-700">回首頁</a>
      {NAV.map((n) => (
        <a href={n.href} class="rounded-full border border-sand-200 bg-white px-4 py-2 text-sm font-semibold text-harbor-900 hover:border-sea-400">{n.label}</a>
      ))}
    </div>
  </div>
</BaseLayout>
