---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FAQ } from '../data/faq';

const crumbs = [
  { name: '首頁', href: '/' },
  { name: '常見問題', href: '/faq/' },
];

const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}];
---
<BaseLayout
  title="旗津常見問題 FAQ"
  description="旗津老街平日有開嗎？要逛多久？值得去嗎？可以開車嗎？渡輪多久一班？下雨天去哪？旗津旅遊常見問題一次解答。"
  breadcrumbs={crumbs}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-3xl px-4 py-8">
    <header class="mb-8">
      <h1 class="text-3xl font-bold text-harbor-900">常見問題</h1>
      <p class="mt-3 text-ink-700">關於旗津旅遊最常被問到的問題，先給你直接的答案。</p>
    </header>

    <div class="space-y-3">
      {FAQ.map((f) => (
        <details class="group rounded-xl border border-sand-200 bg-white p-5 open:shadow-sm">
          <summary class="flex cursor-pointer items-center justify-between gap-4 font-bold text-harbor-900 list-none">
            <span>{f.q}</span>
            <svg class="h-5 w-5 shrink-0 text-sea-500 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
          </summary>
          <p class="mt-3 text-ink-700 leading-relaxed">{f.a}</p>
          {f.href && <a href={f.href} class="mt-2 inline-block text-sm font-semibold text-sea-700 hover:text-sea-500">看詳細 →</a>}
        </details>
      ))}
    </div>
  </div>
</BaseLayout>
