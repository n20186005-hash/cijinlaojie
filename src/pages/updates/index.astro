---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { UPDATES, UPDATE_INTERVALS } from '../../data/updates';

const crumbs = [
  { name: '首頁', href: '/' },
  { name: '最新資訊', href: '/updates/' },
];

const tagColors: Record<string, string> = {
  '渡輪': 'bg-harbor-900 text-sand-50',
  '施工': 'bg-temple-500 text-white',
  '店家': 'bg-sunset-500 text-white',
  '活動': 'bg-sea-500 text-white',
  '景點': 'bg-sea-700 text-white',
  '一般': 'bg-ink-700 text-white',
};
---
<BaseLayout
  title="旗津最新資訊與更新日誌"
  description="旗津渡輪、施工、店家與活動的最新更新，以及本站的資料核對頻率。掌握出發前需要知道的變化。"
  breadcrumbs={crumbs}
>
  <div class="mx-auto max-w-3xl px-4 py-8">
    <header class="mb-8">
      <h1 class="text-3xl font-bold text-harbor-900">最新資訊</h1>
      <p class="mt-3 text-ink-700 leading-relaxed">
        旅遊資訊最怕過期。這裡記錄渡輪、施工、店家與活動的近期變化與本站的核對紀錄。
      </p>
    </header>

    <ol class="space-y-4">
      {UPDATES.map((u) => (
        <li class="rounded-xl border border-sand-200 bg-white p-5">
          <div class="flex items-center gap-3">
            <span class={`rounded-full px-2.5 py-0.5 text-xs font-bold ${tagColors[u.tag]}`}>{u.tag}</span>
            <time datetime={u.date} class="text-sm font-mono text-ink-700">{u.date.replaceAll('-', '/')}</time>
          </div>
          <h2 class="mt-2 font-bold text-harbor-900">{u.title}</h2>
          <p class="mt-1 text-sm text-ink-700 leading-relaxed">{u.detail}</p>
        </li>
      ))}
    </ol>

    <section class="mt-10 rounded-xl border border-sand-200 bg-sand-100 p-5">
      <h2 class="text-lg font-bold text-harbor-900 mb-3">資料核對頻率</h2>
      <ul class="grid gap-2 sm:grid-cols-2 text-sm">
        {UPDATE_INTERVALS.map((x) => (
          <li class="flex items-center justify-between rounded-lg bg-white px-3 py-2">
            <span class="text-ink-900">{x.type}</span>
            <span class="font-semibold text-sea-700">{x.freq}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
