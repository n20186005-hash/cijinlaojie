---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MapExplorer from '../../components/MapExplorer.astro';
import { WALK_LEGS } from '../../data/places';

const crumbs = [
  { name: '首頁', href: '/' },
  { name: '實用地圖', href: '/map/' },
];
---
<BaseLayout
  title="旗津實用地圖：景點、美食、廁所與停車"
  description="旗津互動地圖，可依景點、美食、廁所、停車場、腳踏車租借、看夕陽、推車友善、雨天可去等條件篩選，並顯示距輪渡站距離與步行時間。"
  breadcrumbs={crumbs}
>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <header class="mb-6 max-w-2xl">
      <h1 class="text-3xl font-bold text-harbor-900">旗津實用地圖</h1>
      <p class="mt-3 text-ink-700 leading-relaxed">
        用條件篩選旗津的景點、美食、廁所、停車場與腳踏車租借點，每個地點都標示與輪渡站的距離、
        步行時間與是否需要爬坡。點「在地圖開啟」可用 Google 地圖導航。
      </p>
    </header>

    <MapExplorer />

    <section class="mt-10 rounded-xl border border-sand-200 bg-white p-5">
      <h2 class="text-lg font-bold text-harbor-900 mb-3">常用步行距離</h2>
      <ul class="grid gap-2 sm:grid-cols-2 text-sm">
        {WALK_LEGS.map((leg) => (
          <li class="flex items-center justify-between rounded-lg bg-sand-100 px-3 py-2">
            <span class="text-ink-900">{leg.from} → {leg.to}</span>
            <span class="font-semibold text-sea-700">{leg.time}</span>
          </li>
        ))}
      </ul>
      <p class="mt-3 text-xs text-ink-700">距離與時間依可靠地圖資料概估，實際以現場為準。</p>
    </section>
  </div>
</BaseLayout>
