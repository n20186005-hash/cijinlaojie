---
import Logo from './Logo.astro';
import { NAV } from '../config';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---
<header class="sticky top-0 z-40 bg-sand-50/95 backdrop-blur border-b border-sand-200">
  <nav class="mx-auto max-w-6xl px-4" aria-label="主要導覽">
    <div class="flex items-center justify-between h-16">
      <Logo />
      <ul class="hidden md:flex items-center gap-1">
        {NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'px-3 py-2 rounded-md text-sm font-semibold transition-colors',
                isActive(item.href)
                  ? 'text-harbor-900 bg-sand-200'
                  : 'text-ink-700 hover:text-harbor-900 hover:bg-sand-100',
              ]}
            >{item.label}</a>
          </li>
        ))}
      </ul>

      <details class="md:hidden relative">
        <summary class="list-none cursor-pointer p-2 -mr-2 rounded-md hover:bg-sand-100" aria-label="開啟選單">
          <svg class="h-6 w-6 text-harbor-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </summary>
        <ul class="absolute right-0 top-full mt-2 w-52 bg-white rounded-lg shadow-lg border border-sand-200 py-2">
          {NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'block px-4 py-2.5 text-sm font-semibold',
                  isActive(item.href) ? 'text-harbor-900 bg-sand-100' : 'text-ink-700 hover:bg-sand-100',
                ]}
              >{item.label}</a>
            </li>
          ))}
        </ul>
      </details>
    </div>
  </nav>
</header>
