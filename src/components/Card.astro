---
import Pic from './Pic.astro';
interface Props {
  href: string;
  title: string;
  subtitle?: string;
  image: string;
  imageAlt: string;
  badge?: string;
  meta?: string;
}
const { href, title, subtitle, image, imageAlt, badge, meta } = Astro.props;
---
<a href={href} class="group flex flex-col overflow-hidden rounded-xl border border-sand-200 bg-white shadow-sm transition-shadow hover:shadow-md">
  <div class="relative overflow-hidden">
    <Pic src={image} alt={imageAlt} aspect="3/2" sizes="(max-width:640px) 100vw, 380px"
      class="w-full aspect-[3/2] object-cover transition-transform duration-300 group-hover:scale-105" />
    {badge && (
      <span class="absolute top-2 left-2 rounded-full bg-sunset-500 px-2.5 py-0.5 text-xs font-bold text-white shadow">{badge}</span>
    )}
  </div>
  <div class="flex flex-1 flex-col p-4">
    <h3 class="font-bold text-harbor-900 leading-snug group-hover:text-sea-700">{title}</h3>
    {subtitle && <p class="mt-1.5 text-sm text-ink-700 leading-relaxed line-clamp-3 flex-1">{subtitle}</p>}
    {meta && <p class="mt-2 text-xs font-medium text-sea-500">{meta}</p>}
  </div>
</a>
