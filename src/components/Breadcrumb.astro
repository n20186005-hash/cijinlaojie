---
import type { Crumb } from '../lib/seo';
interface Props { crumbs: Crumb[] }
const { crumbs } = Astro.props;
---
<nav aria-label="麵包屑" class="mx-auto max-w-6xl px-4 pt-4">
  <ol class="flex flex-wrap items-center gap-1.5 text-xs text-ink-700">
    {crumbs.map((c, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true" class="text-sand-200">/</span>}
        {i < crumbs.length - 1 ? (
          <a href={c.href} class="hover:text-sea-700 hover:underline underline-offset-2">{c.name}</a>
        ) : (
          <span aria-current="page" class="text-ink-900 font-semibold">{c.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
